# ─────────────────────────────────────────────────────────────
# MANEXA — production environment (template)
# Provide these as real secrets via your platform's secret manager
# (k8s Secret / ECS task secrets / Vercel env), NOT a committed file.
# Validated at boot by src/lib/env.ts — a weak/placeholder secret aborts startup.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Managed PostgreSQL. On serverless (Vercel), you MUST use a POOLED connection,
# or Prisma exhausts Postgres connections under concurrency → runtime crashes.
#
# Supabase → use the "Transaction" pooler (port 6543) as DATABASE_URL:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
# and the DIRECT connection (port 5432) for migrations only:
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Strong random secret — generate with:  openssl rand -base64 48
SESSION_SECRET="__set_a_real_64_char_random_secret__"

# Dedicated biometric-template key (recommended in prod; rotate via KMS).
FACE_ENC_KEY="__set_a_real_32_char_random_key__"

# Redis (rate limiting / cache / BullMQ workers).
REDIS_URL="redis://REDIS_HOST:6379"

# Upstash Redis (REST) — STRONGLY RECOMMENDED on Vercel/serverless: the
# distributed rate limiter needs a shared store, otherwise brute-force limits
# are per-instance and easily bypassed. Set BOTH.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="__your_upstash_rest_token__"

# Web Push (VAPID) — enables phone push notifications. Generate ONCE with
# `npx web-push generate-vapid-keys` and reuse the SAME pair across deploys
# (rotating them invalidates every existing subscription).
NEXT_PUBLIC_VAPID_PUBLIC_KEY="__your_vapid_public_key__"
VAPID_PRIVATE_KEY="__your_vapid_private_key__"
VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Demo mode OFF in production — no sample credentials shown. (Leave unset or "false".)
# NEXT_PUBLIC_DEMO_MODE=false

# Platform super-admin, created once by `npm run db:seed:prod`.
SUPERADMIN_EMAIL="admin@yourdomain.com"
SUPERADMIN_PASSWORD="__set_a_strong_password__"

# Supabase JS keys — OPTIONAL (only if you enable supabase-js realtime/storage).
# The production data layer uses Prisma via DATABASE_URL above.
# NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
