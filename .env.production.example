# ─────────────────────────────────────────────────────────────
# MANEXA — production environment (template)
# Provide these as real secrets via your platform's secret manager
# (k8s Secret / ECS task secrets / Vercel env), NOT a committed file.
# Validated at boot by src/lib/env.ts — a weak/placeholder secret aborts startup.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production

# Managed PostgreSQL (RDS / Cloud SQL / Supabase). Use a pooled endpoint
# (RDS Proxy / PgBouncer / Supabase pooler) for serverless/high concurrency.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/manexa?sslmode=require"

# Strong random secret — generate with:  openssl rand -base64 48
SESSION_SECRET="__set_a_real_64_char_random_secret__"

# Dedicated biometric-template key (recommended in prod; rotate via KMS).
FACE_ENC_KEY="__set_a_real_32_char_random_key__"

# Redis (rate limiting / cache / BullMQ workers).
REDIS_URL="redis://REDIS_HOST:6379"

# Demo mode OFF in production — no sample credentials shown. (Leave unset or "false".)
# NEXT_PUBLIC_DEMO_MODE=false

# Platform super-admin, created once by `npm run db:seed:prod`.
SUPERADMIN_EMAIL="admin@yourdomain.com"
SUPERADMIN_PASSWORD="__set_a_strong_password__"

# Supabase JS keys — OPTIONAL (only if you enable supabase-js realtime/storage).
# The production data layer uses Prisma via DATABASE_URL above.
# NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
