# ─────────────────────────────────────────────────────────────
# MANEXA — local development environment (template)
# Copy to `.env` and fill in real values:  cp .env.example .env
# `.env` is gitignored. Prisma CLI + seed + Next.js all read `.env`.
# Validated at boot by src/lib/env.ts.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development

# PostgreSQL only (SQLite is rejected by env validation).
# Local Docker Postgres (see docker-compose.yml):
DATABASE_URL="postgresql://manexa:manexa@localhost:5432/manexa?schema=public"
# …or a managed/Supabase URL (URL-encode special chars, e.g. @ -> %40):
# DATABASE_URL="postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres?sslmode=require"
# Direct connection for migrations (locally = same as DATABASE_URL):
DIRECT_URL="postgresql://manexa:manexa@localhost:5432/manexa?schema=public"

# Session / cookie signing secret (min 16 chars). Also derives the
# face-embedding encryption key unless FACE_ENC_KEY is set below.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: dedicated AES key for biometric templates (min 16 chars).
# FACE_ENC_KEY="another-long-random-string"

# Optional: bcrypt work factor (default 11 ≈ 130ms verify, meets <250ms login
# target). Raise to 12 for more margin if you can afford ~260ms.
# BCRYPT_COST=11

# Optional: Razorpay online fee payments. Set BOTH to accept live card/UPI/
# netbanking payments from parents; without them the app uses the simulated
# offline flow. Get these from the Razorpay dashboard → Settings → API Keys.
# NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
# RAZORPAY_KEY_SECRET="your_razorpay_key_secret"

# Optional: enables the Redis-backed rate limiter / cache when set.
# REDIS_URL="redis://localhost:6379"

# Optional: Upstash Redis (REST) — distributed rate limiter across serverless
# instances. Without BOTH, the limiter falls back to per-instance in-memory
# (weak on serverless). Copy from Upstash console → REST API.
# UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Optional: Web Push (VAPID) — buzzes a user's phone even when the app is
# closed. Generate a keypair once with:  npx web-push generate-vapid-keys
# Public key is safe to expose; keep the private key server-only.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
# VAPID_PRIVATE_KEY="your-vapid-private-key"
# VAPID_SUBJECT="mailto:admin@yourdomain.com"

# Optional: Transactional email for OTP / email verification (Resend HTTP API).
# Set to send REAL email; leave unset and codes are logged to the server (dev).
# EMAIL_FROM must be a verified sender/domain in your Resend account.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxx"
# EMAIL_FROM="MANEXA <no-reply@yourdomain.com>"

# Optional: SMS OTP via MSG91 (India). All three enable REAL SMS; otherwise
# codes are logged server-side. The app works email-only without these.
# MSG91_AUTH_KEY="your-msg91-auth-key"
# MSG91_SENDER_ID="MANEXA"
# MSG91_OTP_TEMPLATE_ID="your-msg91-otp-template-id"

# Optional: pepper for hashing one-time codes. Falls back to SESSION_SECRET.
# OTP_SECRET="a-long-random-string-min-16-chars"

# Demo mode — shows sample login credentials on the sign-in page. Dev only.
NEXT_PUBLIC_DEMO_MODE=true

# Supabase JS keys — OPTIONAL. Prisma (DATABASE_URL above) is the data layer and
# does NOT need these. Set the URL + ANON key to enable "Continue with Google"
# (Supabase Auth → Google OAuth); when set, the button appears on /login and the
# app bridges the Google identity into the existing session. See
# docs/google-auth-setup.md for the Google Cloud + Supabase steps. The service
# role key is NOT needed for Google login (leave unset).
# NEXT_PUBLIC_SUPABASE_URL="https://<project>.supabase.co"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"
# SUPABASE_SERVICE_ROLE_KEY="<service-role-key>"
